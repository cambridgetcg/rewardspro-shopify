{% comment %}
  RewardsPro Unified Widget (App Embed)
  A consolidated rewards widget that handles all loyalty program features

  SETUP:
  1. Enable this app embed in Theme Editor → App embeds
  2. Customize settings (position, colors, behavior)
  3. Widget automatically appears on all pages
{% endcomment %}

{% comment %}
  Security: No customer IDs or emails exposed
  Session detection uses meta tags verified server-side
{% endcomment %}

{% if customer %}
  <meta name="rewardspro-session" content="authenticated">
  <meta name="rewardspro-session-check" content="{{ 'now' | date: '%s' | hmac: shop.domain }}">
{% else %}
  <meta name="rewardspro-session" content="guest">
{% endif %}

<div id="rewardspro-widget-root" data-widget-version="2.0.0"></div>

<script>
  // Mark that app embed is active (prevents conflicts)
  window.RewardsProEmbedLoaded = true;

  // SECURE: Only public, non-sensitive configuration
  window.RewardsProConfig = {
    // Session state (boolean only, no IDs or personal data)
    isAuthenticated: {% if customer %}true{% else %}false{% endif %},

    // Shop information (public data only)
    shop: {
      domain: {{ shop.permanent_domain | json }},
      name: {{ shop.name | json }},
      currency: {{ shop.currency | json }},
      moneyFormat: {{ shop.money_format | json }},
      locale: {{ request.locale.iso_code | json }}
    },

    // Public URLs
    urls: {
      account: {{ routes.account_url | json }},
      login: {{ routes.account_login_url | json }},
      register: {{ routes.account_register_url | json }},
      // Protected app proxy endpoint (HMAC verified)
      membershipApi: '/apps/rewardspro/membership'
    },

    // Widget settings from theme customizer
    settings: {
      // Display settings
      position: {{ block.settings.position | default: 'bottom-right' | json }},
      startMinimized: {{ block.settings.start_minimized | default: true }},
      rememberState: {{ block.settings.remember_state | default: true }},
      autoHideDelay: {{ block.settings.auto_hide | default: 0 }},
      showOnMobile: {{ block.settings.show_on_mobile | default: true }},

      // Styling
      themeColor: {{ block.settings.theme_color | default: '#5C6AC4' | json }},
      backgroundColor: {{ block.settings.background_color | default: '#FFFFFF' | json }},
      iconStyle: {{ block.settings.icon_style | default: 'emoji' | json }},
      animationSpeed: {{ block.settings.animation_speed | default: 300 }},

      // Feature toggles
      showProgress: {{ block.settings.show_progress | default: true }},
      showExpiring: {{ block.settings.show_expiring | default: true }},
      showRatings: {{ block.settings.show_ratings | default: false }},

      // Bottom margin
      enableBottomMargin: {{ block.settings.enable_bottom_margin | default: true }},
      bottomMargin: {{ block.settings.bottom_margin | default: 80 }}
    },

    // Content strings
    content: {
      title: {{ block.settings.widget_title | default: 'Rewards Center' | json }},
      guestMessage: {{ block.settings.guest_message | default: 'Join our rewards program and earn cashback on every purchase!' | json }},
      signInText: {{ block.settings.sign_in_text | default: 'Sign In' | json }},
      registerText: {{ block.settings.register_text | default: 'Join Now' | json }},
      ctaText: {{ block.settings.cta_text | default: 'View Rewards' | json }},
      ctaUrl: {{ block.settings.cta_url | default: '/account' | json }}
    },

    // Environment flags
    environment: {
      debug: {% if request.host contains '.myshopify.io' %}true{% else %}false{% endif %},
      timestamp: {{ 'now' | date: '%s' }}
    }
  };
</script>

<style>
  /* Critical CSS for immediate positioning - prevents layout shift */
  #rewardspro-widget-root {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }

  #rewardspro-widget-root .rp-widget-container {
    position: fixed;
    z-index: 999999;
    --rp-theme-color: {{ block.settings.theme_color | default: '#5C6AC4' }};
    --rp-bg-color: {{ block.settings.background_color | default: '#FFFFFF' }};
    --rp-animation-speed: {{ block.settings.animation_speed | default: 300 }}ms;
  }

  /* Position-based styling */
  {% case block.settings.position %}
    {% when 'bottom-right' %}
      #rewardspro-widget-root .rp-widget-container {
        bottom: 20px;
        right: 20px;
      }
    {% when 'bottom-left' %}
      #rewardspro-widget-root .rp-widget-container {
        bottom: 20px;
        left: 20px;
      }
    {% when 'top-right' %}
      #rewardspro-widget-root .rp-widget-container {
        top: 20px;
        right: 20px;
      }
    {% when 'top-left' %}
      #rewardspro-widget-root .rp-widget-container {
        top: 20px;
        left: 20px;
      }
  {% endcase %}

  /* Minimized state */
  #rewardspro-widget-root .rp-widget-minimized {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--rp-theme-color);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--rp-animation-speed) ease;
  }

  #rewardspro-widget-root .rp-widget-minimized:hover {
    transform: scale(1.05);
  }

  /* Mobile visibility */
  {% unless block.settings.show_on_mobile %}
    @media (max-width: 768px) {
      #rewardspro-widget-root { display: none !important; }
    }
  {% endunless %}

  /* Bottom spacer to prevent overlap with page content */
  .rp-widget-bottom-spacer {
    background: transparent;
    pointer-events: none;
    user-select: none;
    clear: both;
  }

  /* Reduce spacing on mobile */
  @media (max-width: 768px) {
    .rp-widget-bottom-spacer {
      height: {{ block.settings.bottom_margin | divided_by: 2 | default: 40 }}px !important;
    }
  }

  /* Ensure spacer works with sticky footers */
  body:has(.sticky-footer) .rp-widget-bottom-spacer {
    height: calc({{ block.settings.bottom_margin | default: 80 }}px + 20px) !important;
  }
</style>

{% comment %} Bottom spacing to prevent widget overlapping page content {% endcomment %}
{% if block.settings.enable_bottom_margin %}
  <div class="rp-widget-bottom-spacer"
       aria-hidden="true"
       style="height: {{ block.settings.bottom_margin | default: 80 }}px; width: 100%; display: block;"></div>
{% endif %}

{% schema %}
{
  "name": "RewardsPro Widget",
  "target": "body",
  "enabled_on": {
    "templates": ["*"]
  },
  "stylesheet": "floating-widget.css",
  "javascript": "floating-widget.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "RewardsPro unified loyalty widget. Displays rewards, balance, tiers, and ratings on all pages."
    },
    {
      "type": "header",
      "content": "Display Settings"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Widget Position",
      "options": [
        { "value": "bottom-right", "label": "Bottom Right" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "top-left", "label": "Top Left" }
      ],
      "default": "bottom-right"
    },
    {
      "type": "checkbox",
      "id": "start_minimized",
      "label": "Start Minimized",
      "info": "Widget starts as a small icon instead of expanded",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "remember_state",
      "label": "Remember Widget State",
      "info": "Remember if user minimized/expanded the widget",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on Mobile Devices",
      "default": true
    },
    {
      "type": "range",
      "id": "auto_hide",
      "label": "Auto-Hide Delay (seconds)",
      "info": "Auto-minimize after this many seconds (0 = never)",
      "min": 0,
      "max": 30,
      "step": 5,
      "default": 0
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "theme_color",
      "label": "Primary Color",
      "default": "#5C6AC4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Icon Style",
      "options": [
        { "value": "emoji", "label": "Emoji (🎁)" },
        { "value": "svg", "label": "SVG Icon" },
        { "value": "text", "label": "Text (Rewards)" }
      ],
      "default": "emoji"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Animation Speed (ms)",
      "min": 100,
      "max": 1000,
      "step": 100,
      "default": 300,
      "unit": "ms"
    },
    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Show Progress to Next Tier",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_expiring",
      "label": "Show Expiring Points Warning",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_ratings",
      "label": "Show Product Ratings",
      "info": "Display star ratings for products (if available)",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "widget_title",
      "label": "Widget Title",
      "default": "Rewards Center"
    },
    {
      "type": "textarea",
      "id": "guest_message",
      "label": "Guest Message",
      "info": "Message shown to non-logged-in customers",
      "default": "Join our rewards program and earn cashback on every purchase!"
    },
    {
      "type": "text",
      "id": "sign_in_text",
      "label": "Sign In Button Text",
      "default": "Sign In"
    },
    {
      "type": "text",
      "id": "register_text",
      "label": "Register Button Text",
      "default": "Join Now"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Call-to-Action Text",
      "default": "View Rewards"
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "Call-to-Action URL",
      "info": "Relative path (e.g., /account) or full URL",
      "default": "/account"
    },
    {
      "type": "header",
      "content": "Page Spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_bottom_margin",
      "label": "Add Bottom Page Margin",
      "info": "Prevents widget from overlapping page content",
      "default": true
    },
    {
      "type": "range",
      "id": "bottom_margin",
      "label": "Bottom Margin Height",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 80,
      "unit": "px"
    }
  ]
}
{% endschema %}
