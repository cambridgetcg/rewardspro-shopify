{% comment %}
  RewardsPro Loyalty Card Widget
  Displays customer's loyalty balance, tier, and progress
{% endcomment %}

{% if customer %}
  <div
    class="rewardspro-loyalty-widget"
    data-customer-id="{{ customer.metafield.rewardspro.customer_id.value }}"
    data-shop="{{ shop.permanent_domain }}"
    data-api-url="{{ block.settings.api_url }}"
    data-variant="{{ block.settings.variant }}"
    data-show-progress="{{ block.settings.show_progress }}"
    data-show-expiring="{{ block.settings.show_expiring }}"
    data-cta-text="{{ block.settings.cta_text }}"
    data-cta-url="{{ block.settings.cta_url }}"
  >
    <div class="rewardspro-widget-loading">
      <div class="rewardspro-spinner"></div>
      <p>{{ 'loyalty.widget.loading' | t }}</p>
    </div>

    <div class="rewardspro-widget-error" style="display: none;">
      <p>{{ 'loyalty.widget.error' | t }}</p>
    </div>

    <div class="rewardspro-widget-content" style="display: none;">
      <!-- Content populated by JavaScript -->
    </div>
  </div>

  {{ 'loyalty-widget.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'loyalty-widget.js' | asset_url }}" defer></script>
{% else %}
  {% if block.settings.show_login_prompt %}
    <div class="rewardspro-login-prompt">
      <p>{{ 'loyalty.widget.login_prompt' | t }}</p>
      <a href="{{ routes.account_login_url }}" class="rewardspro-login-button">
        {{ 'loyalty.widget.login_button' | t }}
      </a>
    </div>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Loyalty Card",
  "target": "section",
  "stylesheet": "loyalty-widget.css",
  "javascript": "loyalty-widget.js",
  "settings": [
    {
      "type": "text",
      "id": "api_url",
      "label": "App API URL",
      "info": "Your RewardsPro app URL (e.g., https://rewardspro-production.vercel.app)",
      "placeholder": "https://your-app.com"
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Widget Style",
      "options": [
        {
          "value": "card",
          "label": "Full Card"
        },
        {
          "value": "compact",
          "label": "Compact Badge"
        },
        {
          "value": "inline",
          "label": "Inline Bar"
        }
      ],
      "default": "card"
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Show Progress to Next Tier",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_expiring",
      "label": "Show Expiring Points Warning",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Call-to-Action Text",
      "default": "View Rewards"
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "Call-to-Action URL",
      "info": "Relative path (e.g., /account) or full URL",
      "default": "/account"
    },
    {
      "type": "checkbox",
      "id": "show_login_prompt",
      "label": "Show Login Prompt for Guest Users",
      "default": true
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Color",
      "default": "#4F46E5"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F9FAFB"
    }
  ]
}
{% endschema %}
