{% comment %}
  RewardsPro Floating Widget (Snippet)
  A persistent, minimizable widget that appears on all pages

  ⚠️  DEPRECATED: Use the App Embed version instead!

  This snippet is kept for backward compatibility only.
  NEW INSTALLATIONS: Enable the app embed in Theme Editor → App embeds

  Manual Usage (legacy):
  Add {% render 'floating-widget' %} to theme.liquid before </body>
{% endcomment %}

{% comment %}
  Prevent conflicts: Only render if app embed is not already active
  App embed sets a marker in window to signal it's loaded
{% endcomment %}
{% if customer %}
  {% assign customer_id = customer.metafield.rewardspro.customer_id.value %}
{% endif %}

<script>
  // Check if app embed already loaded (by checking for the DOM element)
  // This is more reliable than a flag check since the embed creates the element before this script runs
  if (document.getElementById('rewardspro-floating-widget-root')) {
    console.warn('[RewardsPro] App embed already active. Skipping snippet to prevent conflicts.');
  } else {
    // Legacy snippet mode
    (function() {
      const root = document.createElement('div');
      root.id = 'rewardspro-floating-widget-root';
      document.body.appendChild(root);

      window.RewardsProConfig = {
    isAuthenticated: {% if customer %}true{% else %}false{% endif %},
    customerId: {{ customer_id | json }},
    shop: {
      domain: {{ shop.permanent_domain | json }},
      locale: {{ request.locale.iso_code | json }},
      currency: {{ shop.currency | json }}
    },
    urls: {
      account: '{{ routes.account_url }}',
      login: '{{ routes.account_login_url }}',
      register: '{{ routes.account_register_url }}',
      membershipApi: '{{ settings.rewardspro_api_url | default: "https://rewardspro-production.vercel.app" }}/api/storefront/loyalty'
    },
    settings: {
      startMinimized: {{ settings.rewardspro_start_minimized | default: true }},
      rememberState: {{ settings.rewardspro_remember_state | default: true }},
      autoHideDelay: {{ settings.rewardspro_auto_hide | default: 0 }},
      position: {{ settings.rewardspro_position | default: 'bottom-right' | json }},
      iconStyle: {{ settings.rewardspro_icon_style | default: 'emoji' | json }},
      themeColor: {{ settings.rewardspro_theme_color | default: '#5C6AC4' | json }}
    },
    content: {
      title: {{ settings.rewardspro_widget_title | default: 'Rewards Center' | json }},
      guestMessage: {{ settings.rewardspro_guest_message | default: 'Join our rewards program and earn cashback on every purchase!' | json }},
      signInText: {{ 'customer.login.title' | t | default: 'Sign In' | json }},
      registerText: {{ 'customer.register.title' | t | default: 'Join Now' | json }}
    }
      };

      // Load assets
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = '{{ 'floating-widget.css' | asset_url }}';
      document.head.appendChild(link);

      const script = document.createElement('script');
      script.src = '{{ 'floating-widget.js' | asset_url }}';
      script.defer = true;
      document.head.appendChild(script);
    })();
  }
</script>

<style>
  /* Position-based styling */
  {% case settings.rewardspro_position %}
    {% when 'bottom-right' %}
      #rewardspro-floating-widget-root .rp-widget-container {
        bottom: 20px;
        right: 20px;
      }
    {% when 'bottom-left' %}
      #rewardspro-floating-widget-root .rp-widget-container {
        bottom: 20px;
        left: 20px;
      }
    {% when 'top-right' %}
      #rewardspro-floating-widget-root .rp-widget-container {
        top: 20px;
        right: 20px;
      }
    {% when 'top-left' %}
      #rewardspro-floating-widget-root .rp-widget-container {
        top: 20px;
        left: 20px;
      }
  {% endcase %}

  /* Theme color customization */
  {% if settings.rewardspro_theme_color %}
    #rewardspro-floating-widget-root .rp-widget-container {
      --rp-theme-color: {{ settings.rewardspro_theme_color }};
    }
  {% endif %}
</style>
