{% comment %}
  RewardsPro Floating Widget
  A persistent, minimizable widget that appears on all pages

  Usage: Add {% render 'floating-widget' %} to theme.liquid before </body>
{% endcomment %}

{% if customer %}
  {% assign customer_id = customer.metafield.rewardspro.customer_id.value %}
{% endif %}

<div id="rewardspro-floating-widget-root"></div>

<script>
  window.RewardsProConfig = {
    isAuthenticated: {{ customer != null }},
    customerId: {{ customer_id | json }},
    shop: {
      domain: {{ shop.permanent_domain | json }},
      locale: {{ request.locale.iso_code | json }},
      currency: {{ shop.currency | json }}
    },
    urls: {
      account: '{{ routes.account_url }}',
      login: '{{ routes.account_login_url }}',
      register: '{{ routes.account_register_url }}',
      membershipApi: '{{ settings.rewardspro_api_url | default: "https://rewardspro-production.vercel.app" }}/api/storefront/loyalty'
    },
    settings: {
      startMinimized: {{ settings.rewardspro_start_minimized | default: true }},
      rememberState: {{ settings.rewardspro_remember_state | default: true }},
      autoHideDelay: {{ settings.rewardspro_auto_hide | default: 0 }},
      position: {{ settings.rewardspro_position | default: 'bottom-right' | json }},
      iconStyle: {{ settings.rewardspro_icon_style | default: 'emoji' | json }},
      themeColor: {{ settings.rewardspro_theme_color | default: '#5C6AC4' | json }}
    },
    content: {
      title: {{ settings.rewardspro_widget_title | default: 'Rewards Center' | json }},
      guestMessage: {{ settings.rewardspro_guest_message | default: 'Join our rewards program and earn cashback on every purchase!' | json }},
      signInText: {{ 'customer.login.title' | t | default: 'Sign In' | json }},
      registerText: {{ 'customer.register.title' | t | default: 'Join Now' | json }}
    }
  };
</script>

{{ 'floating-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'floating-widget.js' | asset_url }}" defer></script>

<style>
  /* Position-based styling */
  {% case settings.rewardspro_position %}
    {% when 'bottom-right' %}
      #rewardspro-floating-widget-root .rp-widget-container {
        bottom: 20px;
        right: 20px;
      }
    {% when 'bottom-left' %}
      #rewardspro-floating-widget-root .rp-widget-container {
        bottom: 20px;
        left: 20px;
      }
    {% when 'top-right' %}
      #rewardspro-floating-widget-root .rp-widget-container {
        top: 20px;
        right: 20px;
      }
    {% when 'top-left' %}
      #rewardspro-floating-widget-root .rp-widget-container {
        top: 20px;
        left: 20px;
      }
  {% endcase %}

  /* Theme color customization */
  {% if settings.rewardspro_theme_color %}
    #rewardspro-floating-widget-root .rp-widget-container {
      --rp-theme-color: {{ settings.rewardspro_theme_color }};
    }
  {% endif %}
</style>
