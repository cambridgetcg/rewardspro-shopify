{% comment %}
  RewardsPro Floating Widget
  A persistent, minimizable widget that appears on all pages

  Usage: Add {% render 'floating-widget' %} to theme.liquid before </body>
{% endcomment %}

{% if customer %}
  {% assign customer_id = customer.metafield.rewardspro.customer_id.value %}
{% endif %}

<div id="rewardspro-floating-widget-root"></div>

<script>
  window.RewardsProConfig = {
    isAuthenticated: {{ customer != null }},
    customerId: {{ customer_id | json }},
    shop: {
      domain: {{ shop.permanent_domain | json }},
      locale: {{ request.locale.iso_code | json }},
      currency: {{ shop.currency | json }}
    },
    urls: {
      account: '{{ routes.account_url }}',
      login: '{{ routes.account_login_url }}',
      register: '{{ routes.account_register_url }}',
      membershipApi: '{{ settings.rewardspro_api_url | default: "https://rewardspro-production.vercel.app" }}/api/storefront/loyalty'
    },
    settings: {
      startMinimized: {{ settings.rewardspro_start_minimized | default: true }},
      rememberState: {{ settings.rewardspro_remember_state | default: true }},
      autoHideDelay: {{ settings.rewardspro_auto_hide | default: 0 }},
      position: {{ settings.rewardspro_position | default: 'bottom-right' | json }},
      iconStyle: {{ settings.rewardspro_icon_style | default: 'emoji' | json }},
      themeColor: {{ settings.rewardspro_theme_color | default: '#5C6AC4' | json }}
    },
    content: {
      title: {{ settings.rewardspro_widget_title | default: 'Rewards Center' | json }},
      guestMessage: {{ settings.rewardspro_guest_message | default: 'Join our rewards program and earn cashback on every purchase!' | json }},
      signInText: {{ 'customer.login.title' | t | default: 'Sign In' | json }},
      registerText: {{ 'customer.register.title' | t | default: 'Join Now' | json }}
    }
  };
</script>

{{ 'floating-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'floating-widget.js' | asset_url }}" defer></script>

<style>
  /* Position-based styling */
  {% case settings.rewardspro_position %}
    {% when 'bottom-right' %}
      #rewardspro-floating-widget-root .rp-widget-container {
        bottom: 20px;
        right: 20px;
      }
    {% when 'bottom-left' %}
      #rewardspro-floating-widget-root .rp-widget-container {
        bottom: 20px;
        left: 20px;
      }
    {% when 'top-right' %}
      #rewardspro-floating-widget-root .rp-widget-container {
        top: 20px;
        right: 20px;
      }
    {% when 'top-left' %}
      #rewardspro-floating-widget-root .rp-widget-container {
        top: 20px;
        left: 20px;
      }
  {% endcase %}

  /* Theme color customization */
  {% if settings.rewardspro_theme_color %}
    #rewardspro-floating-widget-root .rp-widget-container {
      --rp-theme-color: {{ settings.rewardspro_theme_color }};
    }
  {% endif %}
</style>

{% schema %}
{
  "name": "RewardsPro Floating Widget",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Configure the RewardsPro floating loyalty widget that appears on all pages."
    },
    {
      "type": "checkbox",
      "id": "rewardspro_enabled",
      "label": "Enable Floating Widget",
      "default": true
    },
    {
      "type": "text",
      "id": "rewardspro_api_url",
      "label": "App API URL",
      "info": "Your RewardsPro app URL (leave blank to use default production URL)",
      "placeholder": "https://rewardspro-production.vercel.app"
    },
    {
      "type": "header",
      "content": "Display Settings"
    },
    {
      "type": "select",
      "id": "rewardspro_position",
      "label": "Widget Position",
      "options": [
        {
          "value": "bottom-right",
          "label": "Bottom Right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom Left"
        },
        {
          "value": "top-right",
          "label": "Top Right"
        },
        {
          "value": "top-left",
          "label": "Top Left"
        }
      ],
      "default": "bottom-right"
    },
    {
      "type": "checkbox",
      "id": "rewardspro_start_minimized",
      "label": "Start Minimized",
      "info": "Widget starts as a small icon instead of expanded",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "rewardspro_remember_state",
      "label": "Remember Widget State",
      "info": "Remember if user minimized/expanded the widget",
      "default": true
    },
    {
      "type": "range",
      "id": "rewardspro_auto_hide",
      "label": "Auto-Hide Delay (seconds)",
      "info": "Auto-minimize after this many seconds (0 = never)",
      "min": 0,
      "max": 30,
      "step": 5,
      "default": 0
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "rewardspro_theme_color",
      "label": "Theme Color",
      "default": "#5C6AC4"
    },
    {
      "type": "select",
      "id": "rewardspro_icon_style",
      "label": "Icon Style",
      "options": [
        {
          "value": "emoji",
          "label": "Emoji (⭐)"
        },
        {
          "value": "text",
          "label": "Text (Rewards)"
        }
      ],
      "default": "emoji"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "rewardspro_widget_title",
      "label": "Widget Title",
      "default": "Rewards Center"
    },
    {
      "type": "textarea",
      "id": "rewardspro_guest_message",
      "label": "Guest Message",
      "info": "Message shown to non-logged-in customers",
      "default": "Join our rewards program and earn cashback on every purchase!"
    }
  ]
}
{% endschema %}
