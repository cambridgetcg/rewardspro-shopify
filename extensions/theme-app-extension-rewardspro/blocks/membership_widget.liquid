<!-- Membership Widget Block -->
{% comment %}
  Automatic State Detection:
  - If customer is NOT logged in -> Show CTA (prompt to sign in)
  - If customer IS logged in -> Show member info
  - Settings can override this behavior
{% endcomment %}

{% if customer %}
  {% comment %} Customer is logged in - show member state {% endcomment %}
  <div id="membership-widget-root"
       data-logged-in="true"
       data-customer-id="{{ customer.id }}"
       data-customer-email="{{ customer.email }}"
       data-shop-domain="{{ shop.permanent_domain }}"
       data-shop-currency="{{ shop.currency }}"
       data-tier-name="{{ block.settings.tier_name | default: 'Rewards' }}"
       data-balance="{{ block.settings.balance | default: '$0.00' }}">
  </div>
{% else %}
  {% comment %} Customer is NOT logged in - show CTA state {% endcomment %}
  <div id="membership-widget-root"
       data-logged-in="false"
       data-shop-domain="{{ shop.permanent_domain }}"
       data-shop-currency="{{ shop.currency }}"
       data-message="{{ block.settings.guest_message | default: 'Sign in to view your rewards and store credit' }}"
       data-cta-text="{{ block.settings.guest_cta_text | default: 'Sign In' }}"
       data-cta-url="{{ block.settings.guest_cta_url | default: '/account/login' }}">
  </div>
{% endif %}

{% schema %}
{
  "name": "RewardsPro Widget",
  "target": "body",
  "stylesheet": "membership-widget.css",
  "javascript": "membership-widget.js",
  "settings": [
    {
      "type": "header",
      "content": "Logged-In Member Settings"
    },
    {
      "type": "paragraph",
      "content": "These settings apply when a customer is signed in"
    },
    {
      "type": "text",
      "id": "tier_name",
      "label": "Tier Name",
      "default": "Rewards",
      "info": "The name displayed in the header (e.g., 'Rewards', 'Gold Member')"
    },
    {
      "type": "text",
      "id": "balance",
      "label": "Balance Amount",
      "default": "$0.00",
      "info": "The store credit balance to display (e.g., '$25.00')"
    },
    {
      "type": "header",
      "content": "Guest User Settings"
    },
    {
      "type": "paragraph",
      "content": "These settings apply when a customer is NOT signed in (automatically detected)"
    },
    {
      "type": "text",
      "id": "guest_message",
      "label": "Guest Message",
      "default": "Sign in to view your rewards and store credit",
      "info": "Message shown to non-logged-in visitors"
    },
    {
      "type": "text",
      "id": "guest_cta_text",
      "label": "Guest Button Text",
      "default": "Sign In",
      "info": "Text on the sign-in button for guests"
    },
    {
      "type": "text",
      "id": "guest_cta_url",
      "label": "Guest Button URL",
      "default": "/account/login",
      "info": "URL the sign-in button links to"
    }
  ]
}
{% endschema %}
