{% comment %}
  RewardsPro Membership Widget

  App Proxy Configuration:
  - Widget calls: /apps/rewardspromembership
  - TOML config: url="/api/proxy", subpath="rewardspromembership", prefix="apps"
  - Backend route: api.proxy.$.tsx handles /api/proxy/*

  Request Flow:
  1. Liquid extracts customer ID from Shopify GID
  2. Widget JS calls /apps/rewardspromembership?shopifyCustomerId={id}
  3. Shopify proxy forwards to https://rewardspro-production.vercel.app/api/proxy
  4. Backend verifies HMAC, fetches data, returns JSON
{% endcomment %}

{% if request.design_mode %}
  <!-- Theme Editor Preview Mode -->
  <div
    id="membership-widget-root"
    class="rewards-pro-membership-widget"
    data-api-url="/apps/rewardspromembership"
    data-shopify-customer-id="preview"
    data-customer-email="preview@example.com"
    data-shop-currency="{{ shop.currency }}"
    data-design-mode="true"
  >
    <div style="padding: 20px; background: #f5f5f5; border: 2px dashed #999; border-radius: 8px; text-align: center; font-family: -apple-system, BlinkMacSystemFont, sans-serif;">
      <strong style="font-size: 16px;">🌟 RewardsPro Widget Preview</strong>
      <br>
      <small style="color: #666;">The widget will display for logged-in customers with membership data.</small>
      <div style="margin-top: 15px; padding: 12px; background: white; border-radius: 4px; display: inline-block;">
        <div style="font-weight: 600; color: #333;">Gold Member</div>
        <div style="font-size: 14px; color: #666; margin-top: 4px;">Store Credit: {{ 50.00 | money_with_currency }}</div>
      </div>
    </div>
  </div>

{% elsif customer %}
  {% comment %} Extract numeric customer ID from Shopify GID (e.g., gid://shopify/Customer/123 → 123) {% endcomment %}
  {% assign customer_id_parts = customer.id | split: '/' %}
  {% assign shopify_customer_id = customer_id_parts | last %}

  {% if shopify_customer_id %}
    <div
      id="membership-widget-root"
      class="rewards-pro-membership-widget"
      data-api-url="/apps/rewardspromembership"
      data-shopify-customer-id="{{ shopify_customer_id | escape }}"
      data-customer-email="{{ customer.email | escape }}"
      data-shop-currency="{{ shop.currency | escape }}"
      data-debug="{{ block.settings.debug_mode }}"
    >
      <!-- Fallback content while JavaScript loads -->
      <div style="padding: 15px; text-align: center; color: #666; font-size: 14px;">
        Loading your rewards...
      </div>
      <noscript>
        <div style="padding: 15px; text-align: center; color: #999; font-size: 13px;">
          Please enable JavaScript to view your rewards.
        </div>
      </noscript>
    </div>
  {% endif %}

{% else %}
  <!-- Not logged in - widget won't render -->
{% endif %}

{% schema %}
{
  "name": "RewardsPro Widget",
  "target": "body",
  "javascript": "membership-widget.js",
  "stylesheet": "membership-widget.css",
  "settings": [
    {
      "type": "checkbox",
      "id": "debug_mode",
      "label": "Enable Debug Mode",
      "default": false,
      "info": "Shows detailed error information for troubleshooting"
    }
  ]
}
{% endschema %}
