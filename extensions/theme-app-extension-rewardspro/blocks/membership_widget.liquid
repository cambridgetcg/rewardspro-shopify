<!-- Membership Widget Block -->
<div id="membership-widget-root"
     data-api-url="/apps/rewardspromembership"
     {% if customer %}
       data-shopify-customer-id="{{ customer.id }}"
       data-customer-email="{{ customer.email }}"
     {% endif %}
     data-shop-currency="{{ shop.currency }}"
     data-design-mode="{% if request.design_mode %}true{% else %}false{% endif %}">
</div>

{% schema %}
{
  "name": "RewardsPro Widget",
  "target": "body",
  "stylesheet": "membership-widget.css",
  "javascript": "membership-widget.js",
  "settings": [
    {
      "type": "header",
      "content": "Display Options"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        {"value": "bottom-right", "label": "Bottom Right"},
        {"value": "bottom-left", "label": "Bottom Left"}
      ],
      "default": "bottom-right"
    }
  ]
}
{% endschema %}
