{% comment %}
  App Embed Block: Membership Widget
  This block displays membership tier and store credit information for logged-in customers.

  Data Flow:
  1. Pass Shopify customer ID directly (no metafield needed)
  2. JavaScript fetches loyalty data from: /apps/rewardspro/loyalty?shopifyCustomerId={id}
  3. API looks up customer by shopifyCustomerId + shop domain
  4. API returns: balance, tier name, progress, etc.
{% endcomment %}

<!-- DEBUG: Membership Widget Start -->
<script>
  console.log('[MembershipWidget Liquid] Template loaded');
  console.log('[MembershipWidget Liquid] Customer exists:', {{ customer | json }});
  console.log('[MembershipWidget Liquid] Design mode:', {{ request.design_mode | json }});
</script>

{% comment %} Check if we're in theme editor design mode {% endcomment %}
{% if request.design_mode %}
  <script>
    console.log('[MembershipWidget Liquid] 🎨 Design mode detected - rendering placeholder');
  </script>

  {% comment %} Render placeholder widget for theme editor preview {% endcomment %}
  <div
    id="membership-widget-root"
    class="rewards-pro-membership-widget"
    data-api-url="/apps/rewardspro/loyalty"
    data-shopify-customer-id="preview"
    data-customer-email="customer@example.com"
    data-shop-currency="{{ shop.currency }}"
    data-design-mode="true"
  >
    <div style="padding: 20px; background: #f0f0f0; border: 2px dashed #ccc; text-align: center;">
      <strong>🌟 Preview: Membership Widget</strong>
      <br>
      <small style="color: #666;">This is a placeholder. The actual widget will show for logged-in customers with membership data.</small>
      <br><br>
      <div style="background: white; padding: 10px; border-radius: 4px; display: inline-block;">
        <strong>Gold Member</strong>
        <br>
        <span>Store Credit: {{ 50.00 | money_with_currency }}</span>
      </div>
    </div>
  </div>

{% elsif customer %}
  <script>
    console.log('[MembershipWidget Liquid] Customer is logged in');
    console.log('[MembershipWidget Liquid] Customer ID:', '{{ customer.id }}');
    console.log('[MembershipWidget Liquid] Customer email:', '{{ customer.email }}');
  </script>

  {% comment %} Extract numeric customer ID from GID {% endcomment %}
  {% assign customer_id_parts = customer.id | split: '/' %}
  {% assign shopify_customer_id = customer_id_parts | last %}

  <script>
    console.log('[MembershipWidget Liquid] Extracted Shopify Customer ID:', '{{ shopify_customer_id }}');
  </script>

  {% comment %} Render widget for all logged-in customers {% endcomment %}
  {% if shopify_customer_id %}
    <script>
      console.log('[MembershipWidget Liquid] ✅ Rendering widget container');
    </script>
    <div
      id="membership-widget-root"
      class="rewards-pro-membership-widget"
      data-api-url="/apps/rewardspro/loyalty"
      data-shopify-customer-id="{{ shopify_customer_id | escape }}"
      data-customer-email="{{ customer.email | escape }}"
      data-shop-currency="{{ shop.currency | escape }}"
      style="background: rgba(255,0,0,0.1); padding: 10px; border: 2px solid red;"
    >
      {% comment %}
        Fallback content for users with JavaScript disabled
        JavaScript will fetch data from API and replace this
      {% endcomment %}
      <div style="padding: 20px; background: white; border: 2px dashed blue;">
        <strong>🌟 Loading your membership...</strong>
        <br>
        <small style="color: blue;">Widget container loaded. Fetching data from API...</small>
      </div>
      <noscript>
        <div class="membership-widget-fallback">
          <p>Please enable JavaScript to view your membership information.</p>
        </div>
      </noscript>
    </div>
  {% else %}
    <script>
      console.warn('[MembershipWidget Liquid] ❌ Could not extract Shopify customer ID');
      console.log('[MembershipWidget Liquid] Customer ID format:', '{{ customer.id }}');
    </script>
  {% endif %}
{% else %}
  <script>
    console.warn('[MembershipWidget Liquid] ❌ No customer logged in - widget will not render');
  </script>
{% endif %}
<!-- DEBUG: Membership Widget End -->

{% schema %}
{
  "name": "Membership Widget",
  "target": "body",
  "javascript": "membership-widget.js",
  "stylesheet": "membership-widget.css",
  "settings": [
    {
      "type": "select",
      "id": "position",
      "label": "Widget Position",
      "options": [
        { "value": "bottom-right", "label": "Bottom Right" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "top-left", "label": "Top Left" }
      ],
      "default": "bottom-right"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on Mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "collapsible",
      "label": "Make Collapsible",
      "default": true,
      "info": "Allow users to minimize the widget"
    }
  ]
}
{% endschema %}
