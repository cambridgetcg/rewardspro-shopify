{% comment %}
  RewardsPro Membership Widget - Simple Expandable UI

  This is a UI-only widget that displays a collapsible rewards interface.
  No API calls or data fetching - just a clean, interactive component.
{% endcomment %}

<div id="membership-widget-root" class="rewards-pro-membership-widget">
  <!-- Widget content will be rendered by JavaScript -->
  <div style="padding: 16px; text-align: center; color: #666; font-size: 14px;">
    Loading widget...
  </div>
  <noscript>
    <div style="padding: 16px; text-align: center; color: #999; font-size: 13px;">
      Please enable JavaScript to view this widget.
    </div>
  </noscript>
</div>

{% schema %}
{
  "name": "RewardsPro Widget",
  "target": "body",
  "javascript": "membership-widget.js",
  "stylesheet": "membership-widget.css",
  "settings": [
    {
      "type": "checkbox",
      "id": "debug_mode",
      "label": "Enable Debug Mode",
      "default": false,
      "info": "Shows detailed error information for troubleshooting"
    }
  ]
}
{% endschema %}
